# Conexión a PostgreSQL (la da Coolify al crear la base de datos)
DATABASE_URL=postgres://ainadays:CAMBIA_ESTA_CLAVE@db:5432/ainadays
# Contraseña que pide la app la primera vez que se abre en un móvil. Ponla siempre.
APP_KEY=elige-una-contraseña-larga
# Opcional: clave de la API de Claude (console.anthropic.com) para el consejo «¿Qué hago?»
# ANTHROPIC_API_KEY=sk-ant-...
# Solo para docker-compose
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
# Si tu PostgreSQL exige SSL (bases externas), pon PGSSL=require
# PGSSL=require
PORT=3000
